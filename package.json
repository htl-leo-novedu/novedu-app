{
  "name": "chat-prototype",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "cli",
    "teacher-docs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p cli --noEmit && npm run typecheck --workspace teacher-docs",
    "db:generate": "drizzle-kit generate",
    "generate:schemas": "tsx scripts/generate-activity-schemas.ts",
    "images:init-root": "node scripts/init-image-root.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert \"@live-llm|@live-storage|@live-telemetry\"",
    "test:e2e:live-llm": "playwright test -c playwright.live-llm.config.ts",
    "test:e2e:db": "playwright test --grep @live-db",
    "test:e2e:storage": "playwright test --grep @live-storage",
    "test:e2e:telemetry": "playwright test --grep @live-telemetry",
    "test:e2e:ui": "playwright test --ui",
    "cli": "tsx cli/src/main.ts",
    "cli:build": "npm --workspace @novedu/cli run build",
    "test:cli": "npm run cli:build && vitest run --config cli/vitest.config.mts",
    "docs:dev": "npm run dev --workspace teacher-docs",
    "docs:build": "npm run build --workspace teacher-docs",
    "docs:preview": "npm run preview --workspace teacher-docs",
    "qa": "npm run check && npm run typecheck && npm run test && npm run test:cli && npm run build && npm run docs:build",
    "qa:e2e": "npm run qa && npm run test:e2e"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/mastra": "1.1.1",
    "@ai-sdk/openai": "3.0.101",
    "@ai-sdk/openai-compatible": "2.0.72",
    "@azure/identity": "^4.13.2",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@copilotkit/react-core": "^1.69.2",
    "@copilotkit/runtime": "^1.69.2",
    "@mastra/client-js": "^1.42.0",
    "@mastra/core": "^1.64.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.28.2",
    "@mastra/observability": "^1.17.1",
    "@mastra/pg": "^1.22.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.33.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "handlebars": "^4.7.9",
    "katex": "^0.18.4",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@ag-ui/mastra": {
      "@copilotkit/runtime": "$@copilotkit/runtime"
    },
    "sharp": "^0.35.3",
    "astro": "~7.2.7",
    "rxjs": "$rxjs",
    "cookie": "^2.0.1",
    "express": {
      "cookie": "^0.7.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@copilotkit/aimock": "1.44.0",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
